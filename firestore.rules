rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    /// Checks if the request is originating from an authenticated session.
    function isAuthenticated() {
      return request.auth != null;
    }

    /// Verifies that the caller possesses an active administrator record
    /// in the protected 'users' collection.
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    // ===============================================================
    // Field Validation Functions for Academic Content
    // ===============================================================

    function isValidSemester(data) {
      return data.keys().hasAll(['semesterNumber', 'title', 'isPublished', 'order']) &&
        data.keys().hasOnly(['semesterNumber', 'title', 'description', 'isPublished', 'order']) &&
        data.semesterNumber is int &&
        data.semesterNumber >= 1 && data.semesterNumber <= 12 &&
        data.title is string &&
        data.title.size() > 0 && data.title.size() <= 100 &&
        data.isPublished is bool &&
        data.order is int &&
        (!('description' in data) || data.description is string);
    }

    function isValidSubject(data) {
      return data.keys().hasAll(['semesterId', 'name', 'code', 'isPublished']) &&
        data.keys().hasOnly(['semesterId', 'name', 'code', 'description', 'isPublished', 'order']) &&
        data.semesterId is string && data.semesterId.size() > 0 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
        data.code is string && data.code.size() <= 30 &&
        data.isPublished is bool &&
        (!('order' in data) || data.order is int) &&
        (!('description' in data) || data.description is string);
    }

    function isValidModule(data) {
      return data.keys().hasAll(['subjectId', 'moduleNumber', 'title', 'isPublished']) &&
        data.keys().hasOnly(['subjectId', 'moduleNumber', 'title', 'description', 'isPublished', 'order']) &&
        data.subjectId is string && data.subjectId.size() > 0 &&
        data.moduleNumber is int && data.moduleNumber >= 1 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
        data.isPublished is bool &&
        (!('order' in data) || data.order is int) &&
        (!('description' in data) || data.description is string);
    }

    function isValidResource(data) {
      return data.keys().hasAll(['title', 'subjectId', 'type', 'isPublished']) &&
        data.keys().hasOnly([
          'title', 'semesterId', 'subjectId', 'moduleId',
          'description', 'type', 'fileUrl', 'fileName',
          'fileSize', 'isPublished', 'createdAt'
        ]) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.subjectId is string && data.subjectId.size() > 0 &&
        data.type in ['notes', 'pyq', 'assignment', 'syllabus', 'other'] &&
        data.isPublished is bool &&
        (!('semesterId' in data) || data.semesterId is string) &&
        (!('moduleId' in data) || data.moduleId == null || data.moduleId is string) &&
        (!('description' in data) || data.description is string) &&
        (!('fileUrl' in data) || data.fileUrl == null || data.fileUrl is string) &&
        (!('fileName' in data) || data.fileName is string) &&
        (!('fileSize' in data) || data.fileSize == null || data.fileSize is int) &&
        (!('createdAt' in data) || data.createdAt is timestamp);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Users Collection: Private admin profiles.
    // - Authenticated users may ONLY read their own profile (used by AuthService during login).
    // - User list/enumeration is strictly forbidden.
    // - ALL client-side writes (create, update, delete) are completely DENIED.
    // - Prevents any client from granting admin roles, self-promoting, or modifying isActive.
    // - Admin roles must be provisioned via Firebase Console or Admin SDK.
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false;
    }

    // Semesters: Public read for published items; active admin-only validated writes.
    match /semesters/{semesterId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow create: if isAdmin() && isValidSemester(request.resource.data);
      allow update: if isAdmin() && isValidSemester(request.resource.data);
      allow delete: if isAdmin();
    }

    // Subjects: Public read for published items; active admin-only validated writes.
    match /subjects/{subjectId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow create: if isAdmin() && isValidSubject(request.resource.data);
      allow update: if isAdmin() && isValidSubject(request.resource.data);
      allow delete: if isAdmin();
    }

    // Modules: Public read for published items; active admin-only validated writes.
    match /modules/{moduleId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow create: if isAdmin() && isValidModule(request.resource.data);
      allow update: if isAdmin() && isValidModule(request.resource.data);
      allow delete: if isAdmin();
    }

    // Resources: Public read for published study materials; active admin-only validated writes.
    match /resources/{resourceId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow create: if isAdmin() && isValidResource(request.resource.data);
      allow update: if isAdmin() && isValidResource(request.resource.data);
      allow delete: if isAdmin();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
